    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.1",
    "html-to-text": "^9.0.5",
    "jose": "^6.1.0",
    "openai": "^6.3.0",
    "pg": "^8.16.3",
    "pg-boss": "^12.0.0",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/html-to-text": "^9.0.4",
    "vitest": "^4.1.11"
