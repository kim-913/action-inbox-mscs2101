# API
API_HOST=127.0.0.1
API_PORT=3000
WEB_ORIGIN=http://127.0.0.1:5173
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/action_inbox

# Web: export this in the shell or place in apps/web/.env (Vite root).
VITE_API_URL=http://127.0.0.1:3000

# Provider integration: configure locally, never commit values.
# Use a Google Web application client, never Desktop OAuth credentials.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/v1/auth/google/callback
# GOOGLE_ALLOWED_EMAILS=approved-test-account@example.test
# TOKEN_ENCRYPTION_KEY= (canonical base64 of 32 cryptographically random bytes)
# OPENAI_API_KEY= (configure only after approval to incur provider charges)
OPENAI_MODEL=gpt-4.1-mini
# Explicit cost gate: leave false until paid provider usage is approved.
OPENAI_ENABLED=false
